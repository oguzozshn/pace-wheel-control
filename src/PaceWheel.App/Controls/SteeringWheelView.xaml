<UserControl x:Class="PaceWheel.App.Controls.SteeringWheelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Viewbox Width="190" Height="190">
            <!-- 200 x 200 drawing of a wheel; the whole canvas rotates with the steering. -->
            <Canvas Width="200" Height="200" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="Rotation" Angle="0" />
                </Canvas.RenderTransform>

                <!-- Rim -->
                <Ellipse Width="184" Height="184" Canvas.Left="8" Canvas.Top="8"
                         Stroke="{StaticResource RimBrush}" StrokeThickness="20" />
                <Ellipse Width="204" Height="204" Canvas.Left="-2" Canvas.Top="-2"
                         Stroke="{StaticResource RimEdgeBrush}" StrokeThickness="1.5" />
                <Ellipse Width="164" Height="164" Canvas.Left="18" Canvas.Top="18"
                         Stroke="{StaticResource RimEdgeBrush}" StrokeThickness="1.5" />

                <!-- Spokes: left, right, bottom -->
                <Path Fill="{StaticResource RimBrush}" Data="M 22,92 L 72,88 L 72,112 L 22,108 Z" />
                <Path Fill="{StaticResource RimBrush}" Data="M 178,92 L 128,88 L 128,112 L 178,108 Z" />
                <Path Fill="{StaticResource RimBrush}" Data="M 90,128 L 110,128 L 106,180 L 94,180 Z" />

                <!-- Hub -->
                <Ellipse Width="62" Height="62" Canvas.Left="69" Canvas.Top="69"
                         Fill="#202023" Stroke="{StaticResource RimEdgeBrush}" StrokeThickness="2" />
                <TextBlock Text="PACE" Canvas.Left="80" Canvas.Top="91" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource RacingAccentBrush}" />

                <!-- Top-center marker -->
                <Rectangle Width="8" Height="22" Canvas.Left="96" Canvas.Top="-1" RadiusX="2" RadiusY="2"
                           Fill="{StaticResource RacingAccentBrush}" />
            </Canvas>
        </Viewbox>
        <TextBlock x:Name="AngleText" Text="0°" Style="{StaticResource BigNumber}"
                   HorizontalAlignment="Center" Margin="0,8,0,0" />
        <TextBlock x:Name="RangeText" Text="900° aralık" Style="{StaticResource SmallLabel}"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
