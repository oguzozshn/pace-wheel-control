<ui:FluentWindow x:Class="PaceWheel.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:PaceWheel.App.Controls"
                 Title="Pace Wheel Control" Height="760" Width="1040" MinWidth="900" MinHeight="680"
                 WindowBackdropType="Mica" ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterScreen"
                 Loaded="OnLoaded" Closed="OnClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pace Wheel Control" />

        <!-- Header: device name and connection badges -->
        <DockPanel Grid.Row="1" Margin="24,4,24,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="12" Padding="12,4" Background="{StaticResource TrackBrush}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="UsbDot" Width="9" Height="9" Fill="{StaticResource OffBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="UsbText" Text="USB: aranıyor" FontSize="12" />
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Padding="12,4" Background="{StaticResource TrackBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BleDot" Width="9" Height="9" Fill="{StaticResource OffBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="BleText" Text="Bluetooth: bağlı değil" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Rampage Pace V987" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="DeviceSubtitle" Text="Direksiyon bekleniyor…" Style="{StaticResource SmallLabel}" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Live input -->
            <ui:Card Grid.Column="0" Margin="8" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="CANLI GİRİŞ" Style="{StaticResource SectionTitle}" />
                    <controls:SteeringWheelView x:Name="WheelView" HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <controls:PedalBar x:Name="ClutchPedal" Label="DEBRİYAJ" BarBrush="{StaticResource ClutchBrush}" Margin="8,0" />
                        <controls:PedalBar x:Name="BrakePedal" Label="FREN" BarBrush="{StaticResource BrakeBrush}" Margin="8,0" />
                        <controls:PedalBar x:Name="ThrottlePedal" Label="GAZ" BarBrush="{StaticResource ThrottleBrush}" Margin="8,0" />

                        <StackPanel Margin="28,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VİTES" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border Width="72" Height="72" CornerRadius="12" Margin="0,6,0,14"
                                    BorderBrush="{StaticResource RacingAccentBrush}" BorderThickness="2" Background="{StaticResource TrackBrush}">
                                <TextBlock x:Name="GearText" Text="N" FontSize="38" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="D-PAD" Style="{StaticResource SmallLabel}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="PovText" Text="•" FontSize="26" HorizontalAlignment="Center"
                                       Foreground="{StaticResource RacingAccentBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="DÜĞMELER" Style="{StaticResource SectionTitle}" Margin="0,18,0,8" />
                    <UniformGrid x:Name="ButtonGrid" Columns="12" HorizontalAlignment="Left" />
                </StackPanel>
            </ui:Card>

            <!-- Wheel settings over BLE -->
            <ui:Card Grid.Column="1" Margin="8" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                <StackPanel>
                    <TextBlock Text="DİREKSİYON AYARLARI" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Ayarlar Bluetooth üzerinden direksiyona kaydedilir. USB kablosu takılı olsun ve mobil uygulama kapalı olsun."
                               TextWrapping="Wrap" Style="{StaticResource SmallLabel}" FontSize="12" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,18">
                        <ui:Button x:Name="ReadButton" DockPanel.Dock="Right" Content="Oku" Margin="8,0,0,0"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDownload24}" Click="OnRead" />
                        <ui:Button x:Name="FindButton" DockPanel.Dock="Right" Content="Bul" Margin="8,0,0,0"
                                   Appearance="Secondary" Icon="{ui:SymbolIcon Search24}" Click="OnFind" />
                        <ui:TextBox x:Name="AddressBox" PlaceholderText="Bluetooth adresi (ör. DC:32:62:5A:92:91)" />
                    </DockPanel>

                    <controls:SettingSlider x:Name="AngleSetting" Title="Dönüş açısı" Unit="°" Minimum="90" Maximum="1080" Step="90" />
                    <controls:SettingSlider x:Name="FfbSetting" Title="FFB gücü" Unit="" Minimum="0" Maximum="100" Step="5" />
                    <controls:SettingSlider x:Name="SpringSetting" Title="Merkezleme yayı" Unit="" Minimum="0" Maximum="100" Step="2" />

                    <TextBlock x:Name="OtherSettingsText" Text="Sönüm / sürtünme / atalet: -" Style="{StaticResource SmallLabel}"
                               FontSize="12" Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="ApplyButton" Content="Uygula…" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}"
                                   IsEnabled="False" Click="OnApply" Padding="18,6" />
                        <ui:Button x:Name="UndoButton" Content="Geri al…" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUndo24}"
                                   IsEnabled="False" Click="OnUndo" Margin="10,0,0,0" Padding="18,6" />
                        <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True" Width="22" Height="22" Margin="14,0,0,0"
                                         Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- Operation log -->
        <Expander Grid.Row="3" Header="İşlem kaydı" Margin="24,4,24,16">
            <TextBox x:Name="LogBox" Height="130" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap" />
        </Expander>

        <ui:SnackbarPresenter x:Name="SnackbarHost" Grid.Row="0" Grid.RowSpan="4" VerticalAlignment="Bottom" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="4" />
    </Grid>
</ui:FluentWindow>
