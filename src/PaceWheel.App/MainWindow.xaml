<Window x:Class="PaceWheel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pace Wheel Control" Height="620" Width="900" MinWidth="760" MinHeight="520"
        Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="65535"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Live input over DirectInput (non-exclusive, read-only) -->
        <GroupBox Header="Live input (USB)" Grid.Column="0">
            <StackPanel>
                <TextBlock x:Name="InputStatus" Text="Looking for the wheel..." Margin="0,0,0,8"/>
                <TextBlock Text="Steering (X)"/>
                <Grid Margin="0,2,0,8">
                    <ProgressBar x:Name="SteeringBar"/>
                    <TextBlock x:Name="SteeringText" HorizontalAlignment="Center" FontSize="11"/>
                </Grid>
                <TextBlock Text="Throttle (Z)"/>
                <ProgressBar x:Name="ThrottleBar" Margin="0,2,0,8"/>
                <TextBlock Text="Brake (Rz)"/>
                <ProgressBar x:Name="BrakeBar" Margin="0,2,0,8"/>
                <TextBlock Text="Clutch (Slider)"/>
                <ProgressBar x:Name="ClutchBar" Margin="0,2,0,8"/>
                <TextBlock x:Name="PovText" Text="D-pad: center"/>
                <TextBlock x:Name="ButtonsText" Text="Buttons: -" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="GearText" Text="Gear: neutral" FontWeight="Bold" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Settings stored in the wheel, over Bluetooth LE -->
        <GroupBox Header="Wheel settings (Bluetooth LE, stored in the wheel)" Grid.Column="1">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" Margin="0,0,0,8"
                           Text="Keep the USB cable plugged in and close the mobile app before connecting."/>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="FindButton" Content="Find wheel" DockPanel.Dock="Right" Padding="10,2" Margin="6,0,0,0" Click="OnFind"/>
                    <TextBox x:Name="AddressBox" ToolTip="BLE address, e.g. DC:32:62:5A:92:91" VerticalContentAlignment="Center"/>
                </DockPanel>
                <Button x:Name="ReadButton" Content="Read settings" Padding="10,2" HorizontalAlignment="Left" Click="OnRead"/>
                <TextBlock x:Name="CurrentText" Text="Current: (not read yet)" TextWrapping="Wrap" Margin="0,8,0,12"/>

                <TextBlock><Run Text="Rotation angle: "/><Run x:Name="AngleValue" Text="-"/><Run Text="°"/></TextBlock>
                <Slider x:Name="AngleSlider" Minimum="90" Maximum="1080" TickFrequency="90" IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight" ValueChanged="OnSliderChanged" IsEnabled="False" Margin="0,2,0,8"/>
                <TextBlock><Run Text="FFB strength: "/><Run x:Name="FfbValue" Text="-"/></TextBlock>
                <Slider x:Name="FfbSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OnSliderChanged" IsEnabled="False" Margin="0,2,0,8"/>
                <TextBlock><Run Text="Centering spring: "/><Run x:Name="SpringValue" Text="-"/></TextBlock>
                <Slider x:Name="SpringSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="OnSliderChanged" IsEnabled="False" Margin="0,2,0,12"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ApplyButton" Content="Apply..." Padding="10,2" IsEnabled="False" Click="OnApply"/>
                    <Button x:Name="UndoButton" Content="Undo last change..." Padding="10,2" Margin="8,0,0,0" IsEnabled="False" Click="OnUndo"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <TextBox x:Name="LogBox" Grid.Row="1" Grid.ColumnSpan="2" Margin="8" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"/>
    </Grid>
</Window>
