<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flat near-black palette with a cyan accent, in the style of gaming peripheral hubs.
         The "Racing*" key names are kept so existing controls don't need renaming. -->
    <Color x:Key="RacingAccentColor">#00B4FF</Color>
    <SolidColorBrush x:Key="RacingAccentBrush" Color="{StaticResource RacingAccentColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E0F12" />
    <SolidColorBrush x:Key="PanelBrush" Color="#15171B" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#1C1F25" />
    <SolidColorBrush x:Key="DividerBrush" Color="#24272E" />
    <SolidColorBrush x:Key="ThrottleBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="BrakeBrush" Color="#FF4D5E" />
    <SolidColorBrush x:Key="ClutchBrush" Color="#00B4FF" />
    <SolidColorBrush x:Key="TrackBrush" Color="#22252B" />
    <SolidColorBrush x:Key="RimBrush" Color="#26292F" />
    <SolidColorBrush x:Key="RimEdgeBrush" Color="#3A3E46" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8F99" />
    <SolidColorBrush x:Key="OkBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="OffBrush" Color="#555A63" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>

    <!-- Panel: flat rounded block used instead of cards. -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Large icon tile on the home screen. -->
    <Style x:Key="HubTile" TargetType="Button">
        <Setter Property="Width" Value="148" />
        <Setter Property="Height" Value="118" />
        <Setter Property="Margin" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{StaticResource PanelBrush}" CornerRadius="6"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource RacingAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left navigation item on the detail pages. -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="Height" Value="64" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Bd" Background="Transparent">
                        <Rectangle x:Name="Bar" Width="3" HorizontalAlignment="Left" Fill="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Fill" Value="{StaticResource RacingAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource RacingAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
