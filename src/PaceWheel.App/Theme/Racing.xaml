<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Racing palette on top of the WPF-UI dark theme. -->
    <Color x:Key="RacingAccentColor">#FF6A00</Color>
    <SolidColorBrush x:Key="RacingAccentBrush" Color="{StaticResource RacingAccentColor}" />
    <SolidColorBrush x:Key="ThrottleBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="BrakeBrush" Color="#E74C3C" />
    <SolidColorBrush x:Key="ClutchBrush" Color="#3498DB" />
    <SolidColorBrush x:Key="TrackBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="RimBrush" Color="#2B2B2E" />
    <SolidColorBrush x:Key="RimEdgeBrush" Color="#46464B" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="OkBrush" Color="#2ECC71" />
    <SolidColorBrush x:Key="OffBrush" Color="#6B6B70" />

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    </Style>
</ResourceDictionary>
